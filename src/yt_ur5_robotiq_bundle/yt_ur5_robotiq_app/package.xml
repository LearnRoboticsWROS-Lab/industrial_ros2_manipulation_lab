<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yt_ur5_robotiq_app</name>
  <version>0.0.0</version>
  <description>ur application instance of the TrainIt Motion Runtime
    (pick_and_place): launch files, scene + waypoints (bt_params.yaml) and the Behavior
    Tree. Generated by the TrainIt Setup Assistant. Uses trainit_motion_runtime and
    yt_ur5_robotiq_trainit_config.</description>
  <maintainer email="ros.master.ai@gmail.com">fra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>trainit_motion_runtime</exec_depend>
  <exec_depend>yt_ur5_robotiq_trainit_config</exec_depend>
  <exec_depend>yt_ur5_robotiq_description</exec_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
