<!-- Generated by the TrainIt Setup Assistant (pick_and_place). Uniform MoveWaypoint sequence; every DOF is in config/bt_params.yaml. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="UrPickPlace">
      <Log message="ur pick-and-place (BT, data-driven): start"/>

      <MoveWaypoint waypoint="ready"/>
