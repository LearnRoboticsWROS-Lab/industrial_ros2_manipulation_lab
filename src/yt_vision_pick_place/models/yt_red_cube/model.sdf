<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- The demo's own target: a genuinely RED box (ambient+diffuse red, no grey
       material script), sized to be grasped top-down by the Robotiq gripper and
       clearly visible to the colour-segmentation perception. Shipped with the
       yt_vision_pick_place package so the demo is self-contained. -->
  <model name='yt_red_cube'>
    <link name='link'>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.0e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.0e-4</iyy><iyz>0</iyz><izz>1.0e-4</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>0.9 0.05 0.05 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0.2 0.0 0.0 1</emissive>
        </material>
      </visual>
      <collision name='collision'>
        <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
